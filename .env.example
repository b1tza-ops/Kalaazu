# Local-only defaults. setup-local.ps1 replaces both password placeholders.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=kalaazu
MYSQL_USERNAME=kalaazu
MYSQL_PASSWORD=change-me-app-password
MARIADB_ROOT_PASSWORD=change-me-root-password

SPRING_PROFILES_ACTIVE=dev
BIND_ADDRESS=127.0.0.1
WEB_SERVER_PORT=8081
GAME_SERVER_PORT=8080
BROWSER_GAME_PORT=8083
POLICY_SERVER_PORT=843
CHAT_SERVER_PORT=8082
GAME_VERSION=V4
AUTO_START=true
PRINT_IN_PACKETS=false
PRINT_OUT_PACKETS=false
JPA_SHOW_SQL=false
